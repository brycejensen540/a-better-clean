---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { eventPages, type EventPage } from '../../data/events';
import CtaBand from '../../components/CtaBand.astro';

export function getStaticPaths() {
  return eventPages.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

interface Props {
  event: EventPage;
}

const { event } = Astro.props;
const others = eventPages.filter((e) => e.slug !== event.slug);

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: `${event.name} cleanup`,
  description: event.metaDescription,
  provider: {
    '@type': 'LocalBusiness',
    name: site.name,
    url: site.url,
    telephone: '+1-312-555-0148',
    address: { '@type': 'PostalAddress', addressLocality: 'Chicago', addressRegion: 'IL', addressCountry: 'US' },
  },
  areaServed: 'Midwest United States',
});
---

<BaseLayout title={`${event.name} Cleanup | A Better Clean`} description={event.metaDescription} schema={schema}>
  <!-- Page header -->
  <section class="relative overflow-hidden bg-surface">
    <div
      class="pointer-events-none absolute -right-40 -top-40 h-[26rem] w-[26rem] rounded-full opacity-50 blur-3xl"
      style="background: radial-gradient(closest-side, rgba(46, 94, 78, 0.2), transparent 70%);"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-7xl px-4 pb-20 pt-24 sm:px-6 lg:px-8 lg:pb-28 lg:pt-32">
      <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent">
        <span class="h-px w-10 bg-hi" aria-hidden="true"></span>
        {event.eyebrow}
      </p>
      <h1 class="mt-6 max-w-3xl font-display text-5xl font-semibold tracking-tight text-ink sm:text-6xl">
        {event.title}
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-ink-soft">{event.intro}</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="/contact/#quote" class="btn-hi px-8 py-4 text-base">Scope My Event</a>
        <a href={site.phoneHref} class="btn-outline px-8 py-4 text-base">
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3.5 4.5c0-1.1.9-2 2-2h2l1.5 4-2 1.5a11 11 0 005 5l1.5-2 4 1.5v2c0 1.1-.9 2-2 2A12.5 12.5 0 013.5 4.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
          </svg>
          Call {site.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- Body -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mb-16 grid gap-8 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
        <div class="relative aspect-[16/10] overflow-hidden rounded-2xl bg-surface-alt shadow-soft">
          <img
            src={event.image}
            alt={event.name}
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>
        <div class="flex flex-col justify-center rounded-2xl bg-surface-alt p-10 ring-1 ring-ink/8">
          <h2 class="font-display text-2xl font-semibold text-ink">Cleanup for {event.name}</h2>
          <p class="mt-4 text-sm leading-relaxed text-ink-soft">
            Full-service cleanup, overnight turnarounds, recycling &amp; diversion, restroom service, and surface
            washing — scoped to the way {event.name.toLowerCase()} actually generate waste.
          </p>
          <a href="/contact/#quote" class="btn-hi mt-8 self-start px-7 py-3.5 text-sm">Request an Event Quote</a>
        </div>
      </div>

      <div class="grid gap-16 lg:grid-cols-2">
        <div class="reveal space-y-6">
          {event.body.map((paragraph) => (
            <p class="text-lg leading-relaxed text-ink-soft">{paragraph}</p>
          ))}
        </div>

        <div class="space-y-12">
          {event.services && (
            <div class="reveal">
              <h2 class="font-display text-3xl font-semibold tracking-tight text-ink">How We Run It</h2>
              <div class="mt-8 space-y-5">
                {event.services.map((service) => (
                  <div class="rounded-xl bg-white p-7 shadow-soft ring-1 ring-ink/5">
                    <h3 class="font-display text-lg font-semibold text-ink">{service.title}</h3>
                    <p class="mt-3 text-sm leading-relaxed text-ink-soft">{service.description}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {event.notes && (
            <div class="reveal">
              <h2 class="font-display text-3xl font-semibold tracking-tight text-ink">Good to Know</h2>
              <div class="mt-8 space-y-5">
                {event.notes.map((note) => (
                  <div class="flex items-start gap-4 rounded-xl bg-surface-alt p-6 ring-1 ring-ink/8">
                    <svg class="mt-0.5 h-5 w-5 shrink-0 text-hi" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <div>
                      <h3 class="text-sm font-bold text-ink">{note.title}</h3>
                      <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{note.description}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Other event types -->
  <section class="border-t border-ink/8 bg-surface-alt py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-ink">Other Event Types</h2>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/events/" class="rounded-xl border border-ink/15 bg-white px-6 py-3 text-sm font-semibold text-ink shadow-soft transition-all hover:-translate-y-0.5 hover:border-accent hover:text-accent-dark">
          All Event Types
        </a>
        {others.map((other) => (
          <a
            href={`/events/${other.slug}/`}
            class="rounded-xl border border-ink/15 bg-white px-6 py-3 text-sm font-semibold text-ink shadow-soft transition-all hover:-translate-y-0.5 hover:border-accent hover:text-accent-dark"
          >
            {other.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
