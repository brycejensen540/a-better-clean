---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { images } from '../data/images';
import CtaBand from '../components/CtaBand.astro';

const title = 'About Us | A Better Clean — Festival & Event Cleanup';
const description =
  'Meet A Better Clean — the Midwest crew that moves tonnes of event waste overnight so guests focus on the event. Festivals, fairs, parades, and street fests. Call (312) 555-0148.';

const values = [
  {
    title: 'Tonnes Are the Unit',
    text: 'We quote, staff, and report in weight, not vibes. Every event gets a tonnage plan, and every morning you get the numbers that prove it was met.',
  },
  {
    title: 'We Always Show Up',
    text: 'Reliability is our reputation. Night shift, rain shift, load-out shift — our crews arrive as scheduled and walk the grounds with you before handoff.',
  },
  {
    title: 'Guests Never See It',
    text: 'Bins serviced before they overflow, loops timed to crowd flow, hazards flagged before they photograph. The best cleanup is the one nobody notices.',
  },
  {
    title: 'Leave the Grounds Better',
    text: 'Diversion rates documented, surfaces washed, details hand-passed. We hand the venue back cleaner than the permit requires — every time.',
  },
];

const audiences = [
  { name: 'Festival Directors', text: 'Multi-day, multi-stage events where the morning report runs the production meeting.' },
  { name: 'Fair Boards', text: 'Ten-day runs with barns, midways, and grandstands — each zone on its own loop.' },
  { name: 'City Events Offices', text: 'Permit-holders who need documented reopen times, wash photos, and weight tickets.' },
  { name: 'Sponsors & Venues', text: 'Diversion numbers you can publish, and grounds that photograph well for next year’s bid.' },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About A Better Clean',
  url: `${site.url}/about/`,
  about: {
    '@type': 'LocalBusiness',
    name: site.name,
    telephone: '+1-312-555-0148',
    address: { '@type': 'PostalAddress', addressLocality: 'Chicago', addressRegion: 'IL', addressCountry: 'US' },
  },
});
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- Page header -->
  <section class="relative overflow-hidden bg-surface">
    <div
      class="pointer-events-none absolute -right-40 -top-40 h-[26rem] w-[26rem] rounded-full opacity-30 blur-3xl"
      style="background: radial-gradient(closest-side, rgba(46, 94, 78, 0.2), transparent 70%);"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-7xl px-4 pb-20 pt-24 sm:px-6 lg:px-8 lg:pb-28 lg:pt-32">
      <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent">
        <span class="h-px w-10 bg-hi" aria-hidden="true"></span>
        About Us
      </p>
      <h1 class="mt-6 max-w-3xl font-display text-5xl font-semibold tracking-tight text-ink sm:text-6xl">
        The Crew Behind the Clean Grounds
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-ink-soft">
        A Better Clean exists for one reason: public gatherings generate tonnes of waste, and somebody has to move
        them — fast, measurably, and without a single guest noticing. That somebody is us.
      </p>
    </div>
  </section>

  <!-- Story -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto grid max-w-7xl items-center gap-16 px-4 sm:px-6 lg:grid-cols-2 lg:gap-24 lg:px-8">
      <div class="reveal">
        <h2 class="font-display text-4xl font-semibold tracking-tight text-ink">Who We Are</h2>
        <p class="mt-6 leading-relaxed text-ink-soft">
          We started on the night shift of a lakeshore music festival, watching a great event nearly drown in its
          own Sunday morning. The talent was world-class; the cleanup was an afterthought. We founded A Better Clean
          to make the afterthought a discipline.
        </p>
        <p class="mt-4 leading-relaxed text-ink-soft">
          Today we run high-throughput outdoor cleanup for festivals and events across the Midwest: grounds crews on
          loops during event hours, night shifts that consolidate and haul by the tonne, recycling programs with
          documented diversion rates, and the pressure wash that returns the street to the city clean. Roll-off
          trucks, box trucks, sweepers, and 40+ trained crew members — scheduled around your crowd, not a template.
        </p>
        <p class="mt-4 leading-relaxed text-ink-soft">
          We measure everything in weight because weight is what your permit, your sponsor, and your morning-after
          site manager actually care about. Up to 60 tonnes moved per event, overnight — that is the job, and the
          numbers prove it happened.
        </p>
        <p class="mt-6 font-display text-xl font-medium italic text-ink">Massive crowds. Massive cleanup. Never your problem.</p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <a href="/contact/#quote" class="btn-hi px-7 py-3.5 text-sm">Scope My Event</a>
          <a href={site.phoneHref} class="btn-outline px-7 py-3.5 text-sm">Call {site.phone}</a>
        </div>
      </div>
      <div class="reveal">
        <div class="relative aspect-[4/5] overflow-hidden rounded-2xl bg-surface-alt shadow-lift">
          <img
            src={images.about.rig}
            alt="A heavy-duty waste collection truck on an urban route"
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-ink/8 bg-surface-alt" aria-label="Quick facts">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-8 px-4 py-14 sm:px-6 lg:grid-cols-4 lg:px-8">
      {[
        { value: site.stats.tonnesPerEvent, label: 'Tonnes moved per event' },
        { value: site.stats.turnaround, label: 'Grounds turnaround' },
        { value: site.stats.eventsPerSeason, label: 'Events a season' },
        { value: '40+', label: 'Trained crew members' },
      ].map((stat) => (
        <div class="text-center">
          <p class="font-display text-4xl font-semibold text-ink">{stat.value}</p>
          <p class="mt-2 text-sm text-ink-faint">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Crew lead -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="flex items-center justify-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent">
          <span class="h-px w-10 bg-hi" aria-hidden="true"></span>
          The Crew
          <span class="h-px w-10 bg-hi" aria-hidden="true"></span>
        </p>
        <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Night Shift Is Our Day Shift</h2>
      </div>
      <div class="reveal mx-auto mt-14 grid max-w-4xl items-center gap-12 rounded-2xl bg-surface-alt p-10 ring-1 ring-ink/8 sm:p-14 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
        <div class="relative aspect-square overflow-hidden rounded-2xl bg-white shadow-soft">
          <img
            src={images.about.grounds}
            alt="Festival grounds cleared and quiet the morning after the event"
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover object-bottom"
          />
        </div>
        <div>
          <h3 class="font-display text-2xl font-semibold text-ink">The morning after, done right</h3>
          <p class="mt-5 leading-relaxed text-ink-soft">
            “Our favorite view is an empty field at 5 am — swept, stockpiled, and ready for inspection. That’s what
            we chase every night. If your guests never think about waste, and your Monday starts without a shovel in
            anyone’s hand, we did our job.”
          </p>
          <p class="mt-4 leading-relaxed text-ink-soft">
            The A Better Clean crew is 40+ trained members strong, with roll-off trucks, box trucks, and sweepers on
            call. Many of our crew came from events and hospitality — they know what a guest sees, because they’ve
            been the ones making sure of it.
          </p>
          <a href="/contact/#quote" class="btn-hi mt-8 px-7 py-3.5 text-sm">Request an Event Quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="bg-surface-alt py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal max-w-2xl">
        <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent">
          <span class="h-px w-10 bg-hi" aria-hidden="true"></span>
          What Sets Us Apart
        </p>
        <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
          Measured, Documented, and Done Overnight
        </h2>
      </div>
      <div class="mt-14 grid gap-8 sm:grid-cols-2">
        {values.map((value, i) => (
          <div class="reveal card-lift rounded-2xl bg-white p-9 shadow-soft ring-1 ring-ink/5" style={`transition-delay: ${(i % 2) * 60}ms`}>
            <h3 class="font-display text-2xl font-semibold text-ink">{value.title}</h3>
            <p class="mt-4 leading-relaxed text-ink-soft">{value.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who we serve -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal max-w-2xl">
        <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent">
          <span class="h-px w-10 bg-hi" aria-hidden="true"></span>
          Who We Serve
        </p>
        <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
          Organizers, Cities &amp; Venues
        </h2>
      </div>
      <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {audiences.map((audience, i) => (
          <div class="reveal card-lift rounded-2xl bg-surface-alt p-8 ring-1 ring-ink/8" style={`transition-delay: ${(i % 4) * 60}ms`}>
            <h3 class="font-display text-xl font-semibold text-ink">{audience.name}</h3>
            <p class="mt-4 text-sm leading-relaxed text-ink-soft">{audience.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
