---
import { site } from '../data/site';
import { services } from '../data/services';
import { eventPages } from '../data/events';
import Floaters from './Floaters.astro';

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-ink text-white">
  <Floaters />
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 md:grid-cols-2 lg:grid-cols-3 lg:px-8">
    <!-- Brand -->
    <div>
      <a href="/" class="flex items-center gap-2.5" aria-label="A Better Clean — home">
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent text-white">
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 14l3.5-6 3 4 2.5-3.5L17 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M3 17h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </span>
        <span class="font-display text-lg font-semibold tracking-tight text-white">A Better Clean</span>
      </a>
      <p class="mt-5 max-w-xs text-sm leading-relaxed text-white/55">{site.tagline}</p>
      <p class="mt-5 text-sm leading-relaxed text-white/65">
        <strong class="text-hi">{site.stats.tonnesPerEvent} tonnes</strong> moved per event ·
        {site.stats.turnaround} turnarounds · {site.stats.eventsPerSeason} events a season
      </p>
    </div>

    <!-- Services -->
    <nav aria-label="Services">
      <h2 class="text-xs font-bold uppercase tracking-widest text-white/35">Services</h2>
      <ul class="mt-5 space-y-3">
        {services.map((s) => (
          <li><a href={`/services/${s.slug}/`} class="text-sm text-white/60 transition-colors hover:text-hi">{s.name}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Event types -->
    <nav aria-label="Event types">
      <h2 class="text-xs font-bold uppercase tracking-widest text-white/35">Event Types</h2>
      <ul class="mt-5 space-y-3">
        <li><a href="/events/" class="text-sm text-white/60 transition-colors hover:text-hi">All Event Types</a></li>
        {eventPages.map((e) => (
          <li><a href={`/events/${e.slug}/`} class="text-sm text-white/60 transition-colors hover:text-hi">{e.name}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 py-8 text-center text-xs text-white/40 sm:px-6 md:flex-row md:text-left lg:px-8">
      <p>© {year} {site.name}. All rights reserved.</p>
      <div class="flex flex-col items-center gap-1.5 md:flex-row md:gap-6">
        <a href={site.phoneHref} class="transition-colors hover:text-hi">{site.phone}</a>
        <a href={site.emailHref} class="transition-colors hover:text-hi">{site.email}</a>
        <span>{site.hours.weekdays}</span>
      </div>
      <p>{site.tagline}</p>
    </div>
  </div>
</footer>
