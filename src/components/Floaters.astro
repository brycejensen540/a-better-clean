---
// Faint circular markers drifting up through a section — venue-map
// dots rather than bubbles. Place inside a `relative overflow-hidden`
// section (hero, footer). Desktop-weight sections only.

const floaters = [
  { bottom: '6%', left: '5%', size: 14, dur: 22, delay: 0 },
  { bottom: '12%', left: '20%', size: 9, dur: 26, delay: 4 },
  { bottom: '4%', left: '38%', size: 18, dur: 20, delay: 7 },
  { bottom: '10%', left: '55%', size: 10, dur: 24, delay: 2 },
  { bottom: '6%', left: '72%', size: 15, dur: 21, delay: 9 },
  { bottom: '14%', left: '88%', size: 11, dur: 27, delay: 5 },
  { bottom: '8%', left: '45%', size: 22, dur: 23, delay: 12 },
];
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  {floaters.map((b) => (
    <span
      class="floater"
      style={`bottom:${b.bottom};left:${b.left};width:${b.size}px;height:${b.size}px;animation-duration:${b.dur}s;animation-delay:${b.delay}s;`}
    />
  ))}
</div>
